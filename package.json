{
  "name": "accessible-weather-center",
  "version": "0.10.0",
  "private": true,
  "description": "Fully accessible, speech- and keyboard-driven weather application with a Weatherscan-style cycling display.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:electron": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint src electron"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
