# Dependencies
node_modules/

# Build output
dist/
dist-electron/
.vite/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.*
!.env.example

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code (local-only settings, user-specific)
.claude/settings.local.json

# Python (scripts/)
__pycache__/
*.pyc
*.pyo
scripts/out/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Assets (bulk media, external-sourced) — keep the directory in the tree
# but don't commit its contents. Restore the old "assets are core data"
# policy by removing this block if the repo moves back to tracking them.
assets/*
!assets/.gitkeep

# Undo manifests written by scripts/reorganize-assets.mjs. They describe moves
# inside the gitignored media library, so they are machine-local operational
# state, not source — and .asset-migration.json is 2.2 MB of it. Both were
# tracked until v0.13.0. Kept on disk so `--undo` still works locally.
.asset-migration.json
.inbox-triage.json

# Transcoder output (scripts/build-web-assets.mjs). Staging dir before it is
# swapped in as `assets/`; also bulk media, also never committed.
assets-web/

# Media archives built by scripts/package-assets.mjs for a GitHub Release.
dist-assets/

# electron-builder output.
release/

# src/audio/data/ still tracked intentionally — manifests are code, not bulk.
.test-dist/

# Generated by scripts/build-clip-index.mjs during `npm run build`.
public/clip-index.json
sources/

# Music staged for review before promotion into assets/. Hardlinks to
# sources/, so it costs no disk — but it is TWC material and must never be
# committed. Delete it once reviewed.
music-review/
